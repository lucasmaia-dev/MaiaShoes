generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductCategory {
  TENIS
  SAPATOS
  SANDALIAS
  BOLSAS
  SEM_CATEGORIA
}

enum UserRole {
  ADMIN
  CLIENTE
}

model User {
  id                 Int        @id @default(autoincrement())
  name               String     @db.VarChar(100)
  username           String?    @unique @db.VarChar(32)
  email              String?    @unique @db.VarChar(254)
  googleSub          String?    @unique @db.VarChar(255)
  passwordHash       String?
  role               UserRole   @default(CLIENTE)
  createdAt          DateTime   @default(now())
  sessions           Session[]
  feedbacks          Feedback[] @relation("FeedbackAuthor")
  moderatedFeedbacks Feedback[] @relation("FeedbackModerator")
  orders             Order[] @relation("CustomerOrders")
  confirmedOrders    Order[] @relation("PaymentConfirmer")
  orderProgressEvents OrderProgressEvent[]
}

enum FeedbackKind {
  AVALIACAO
  SUGESTAO
}

enum FeedbackStatus {
  PENDENTE
  APROVADO
  ARQUIVADO
}

model Feedback {
  id             Int            @id @default(autoincrement())
  userId         Int
  user           User           @relation("FeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)
  authorName     String         @db.VarChar(100)
  kind           FeedbackKind
  message        String         @db.VarChar(1000)
  rating         Int?
  publishConsent Boolean        @default(false)
  status         FeedbackStatus @default(PENDENTE)
  moderatedById  Int?
  moderatedBy    User?          @relation("FeedbackModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, kind])
  @@index([status, kind, updatedAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.Char(64)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Cada registro desta tabela representa um produto da loja.
model Product {
  id          Int             @id @default(autoincrement())
  catalogCode String?         @unique @db.VarChar(64)
  name        String          @db.VarChar(150)
  description String?
  imageUrl    String?         @db.VarChar(255)
  imageUrls   String[]        @default([])
  category    ProductCategory @default(SEM_CATEGORIA)
  price       Decimal         @db.Decimal(10, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("products")
}

model GoogleLoginAttempt {
  stateHash    String   @id @db.Char(64)
  browserHash  String   @db.Char(64)
  nonce        String   @db.Char(64)
  codeVerifier String   @db.VarChar(128)
  expiresAt    DateTime

  @@index([expiresAt])
}

enum OrderStatus {
  AGUARDANDO_CONFIRMACAO
  AGUARDANDO_PAGAMENTO
  PAGO
}

enum Fulfillment {
  A_COMBINAR
  RETIRADA
  ENTREGA
}

enum OrderFulfillmentStatus {
  AGUARDANDO_PAGAMENTO
  PREPARANDO
  SAIU_PARA_ENTREGA
  PRONTO_PARA_RETIRADA
  CONCLUIDO
}

model Order {
  id               String @id @default(cuid())
  requestId        String @unique @db.Uuid
  userId           Int
  user             User @relation("CustomerOrders", fields: [userId], references: [id], onDelete: Restrict)
  productId        Int
  productName      String @db.VarChar(150)
  imageUrl         String? @db.VarChar(255)
  line             String? @db.VarChar(10)
  size             Int?
  quantity         Int
  unitPriceCents   Int
  subtotalCents    Int?
  items            OrderItem[]
  shippingCents    Int?
  totalCents       Int?
  contact          String @db.VarChar(30)
  fulfillment      Fulfillment
  fulfillmentViaWhatsapp Boolean @default(false)
  deliveryFeeCents Int?
  address          String? @db.VarChar(500)
  status           OrderStatus @default(AGUARDANDO_CONFIRMACAO)
  fulfillmentStatus OrderFulfillmentStatus @default(AGUARDANDO_PAGAMENTO)
  progressEvents   OrderProgressEvent[]
  pixPayload       String?
  pixReceiver      String? @db.VarChar(100)
  confirmedById    Int?
  confirmedBy      User? @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  bankReference    String? @unique @db.VarChar(100)
  paidAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderProgressEvent {
  id          String @id @default(cuid())
  orderId     String
  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderFulfillmentStatus
  status      OrderFulfillmentStatus
  actorId     Int
  actor       User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@unique([orderId, status])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  order          Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position       Int
  productId      Int
  productName    String @db.VarChar(150)
  imageUrl       String? @db.VarChar(255)
  line           String? @db.VarChar(10)
  size           Int?
  quantity       Int
  unitPriceCents Int

  @@unique([orderId, position])
}
